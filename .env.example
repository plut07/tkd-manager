# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long secret used to sign session JWTs. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Tally.so integration (grading registration forms)
# Create a key at https://tally.so/settings/api
TALLY_API_KEY=your-tally-api-key
# Public base URL of this deployment, used for the Tally webhook callback
APP_BASE_URL=https://your-app.vercel.app
